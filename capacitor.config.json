{
  "appId": "com.resumate.claude",
  "appName": "ResuMate",
  "webDir": "www",
  "bundledWebRuntime": false,
  "plugins": {
    "CapacitorUpdater": {
      "appId": "com.resumate.claude",
      "updateUrl": "https://resumate-claude.vercel.app/api/updates",
      "autoUpdate": "always",
      "version": "1.0.0",
      "appReadyTimeout": 10000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "periodCheckDelay": 900
    }
  }
}
